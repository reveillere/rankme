# Copy to .env (same directory as docker-compose.prod.yml) and fill in real
# values. .env itself is gitignored -- never commit real secrets here.

# Required by docker-compose.prod.yml (api service) and by the api container
# to authenticate admin-only endpoints (/api/admin/venues, /api/admin/stats,
# /api/admin/metrics). Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Required by docker-compose.prod.yml for the documented read-only API.
# Multiple tokens may be separated by commas. Prefix a token with a label
# (`alice:<token>`) to record who received it. Generate each with:
# openssl rand -hex 32
API_TOKENS=

# Optional anonymous sync accounts for synchronizing browser data across
# devices: a random code is generated as the sole credential, no email,
# username or third-party login is ever collected. Leave empty to keep the
# application local/offline. Must be at least 32 characters if set.
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Only needed if running monitoring/docker-compose.monitoring.yml (optional
# Prometheus + Grafana stack -- see that file's own comments). Grafana
# falls back to its own default admin/admin if this is left unset, so set
# a real password before ever bringing that stack up on a real server.
GRAFANA_ADMIN_PASSWORD=

# Optional, only used by monitoring/docker-compose.monitoring.yml. How long
# Prometheus keeps scraped metrics on disk. Defaults to 15d if unset.
PROMETHEUS_RETENTION=15d

# Only needed if running analytics/docker-compose.analytics.yml (optional
# self-hosted Umami visitor-analytics stack -- see that file's own
# comments). Both required, no safe default. Generate with:
#   openssl rand -hex 32
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
