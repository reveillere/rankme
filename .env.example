# Copy to .env (same directory as docker-compose.prod.yml) and fill in real
# values. .env itself is gitignored -- never commit real secrets here.

# Required by docker-compose.prod.yml (api service) and by the api container
# to authenticate admin-only endpoints (/api/admin/venues, /api/admin/stats,
# /api/admin/metrics). Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Only needed if running monitoring/docker-compose.monitoring.yml (optional
# Prometheus + Grafana stack -- see that file's own comments). Grafana
# falls back to its own default admin/admin if this is left unset, so set
# a real password before ever bringing that stack up on a real server.
GRAFANA_ADMIN_PASSWORD=

# Optional, only used by monitoring/docker-compose.monitoring.yml. How long
# Prometheus keeps scraped metrics on disk. Defaults to 15d if unset.
PROMETHEUS_RETENTION=15d
