

events { worker_connections 1024; }

http {
    sendfile on;

    # Per-IP rate limiting -- added 2026-09-15 after a distributed scrape
    # was found hammering /author/*, /dblp/* and /api/dblp/author-stream/*
    # (248k+ distinct IPs in 10h, ~1 request/IP, rotating a canned pool of
    # "Chrome on Windows" UAs -- residential-proxy scraping, not a single
    # abusive IP). This caps any one IP's rate rather than solving the
    # distributed pattern itself (each bot IP is already under the limit on
    # its own), but it's still real protection against the requests that do
    # cluster on one IP (the worst offender that day: 1751 reqs/10h from a
    # single IP) and against this or any future scrape escalating on fewer
    # IPs. 20m tracks roughly 320k distinct IPs concurrently (nginx's own
    # ~64 bytes/entry rule of thumb) -- sized for this site's observed
    # unique-IP volume, not a guess.
    limit_req_zone $binary_remote_addr zone=perip_general:20m rate=10r/s;
    limit_req_zone $binary_remote_addr zone=perip_api:20m rate=5r/s;
    limit_conn_zone $binary_remote_addr zone=perip_conn:20m;
    limit_req_status 429;
    limit_conn_status 429;

    server {
        listen 80;
        server_name localhost;

        error_log  /var/log/nginx/error.log;
        access_log /var/log/nginx/access.log;

        # Docker's embedded DNS server: resolving api/front through a
        # variable (below) forces nginx to re-resolve their container IPs
        # on every request instead of caching whatever they were at nginx's
        # own startup -- a static `proxy_pass http://api/;` only resolves
        # once, so recreating the api/front containers without also
        # restarting nginx silently leaves it pointing at a dead/stale IP.
        resolver 127.0.0.11 valid=10s;

        # Preserve links to DBLP author pages from before the tab-based UI.
        location ^~ /author/ {
            rewrite ^/author/(.+)$ /dblp/$1 permanent;
        }

        location / {
            limit_req zone=perip_general burst=20 nodelay;
            limit_conn perip_conn 20;
            set $front_upstream front;
            proxy_pass http://$front_upstream:80;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_cache_bypass $http_upgrade;
            proxy_redirect off;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Serves Let's Encrypt's HTTP-01 challenge files so certbot renew can
        # run unattended (via the existing snap.certbot.renew.timer) instead
        # of the DNS-manual flow this cert was originally issued with, which
        # silently skips on every automated renewal attempt.
        location ^~ /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location ^~ /api/ {
            # Stricter than / -- author-stream is the expensive endpoint
            # (Crossref fetch + CORE/SJR fuzzy matching + mongo queries per
            # item), while burst=15 still covers one real page load's own
            # small fan-out (status + author + author-stream + the two
            # match-overrides/shared calls) without tripping.
            limit_req zone=perip_api burst=15 nodelay;
            limit_conn perip_conn 20;
            set $api_upstream api;
            # proxy_pass can't strip the /api/ prefix itself once the
            # upstream is a variable (a documented nginx quirk: URI
            # rewriting via the trailing "/" only applies to a literal,
            # statically-resolved proxy_pass target) -- so do it explicitly.
            rewrite ^/api/(.*)$ /$1 break;
            proxy_pass http://$api_upstream:80;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_cache_bypass $http_upgrade;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_buffering off;
            proxy_read_timeout 120s;
        }
        
        # Optional: only resolves/works once monitoring/docker-compose.
        # monitoring.yml is deployed alongside this one (see that file) --
        # until then this location just 502s on request, which is harmless
        # (same graceful-per-request-resolution behavior as /api/ and /
        # above, not a startup failure) since nothing links to it yet.
        # Grafana gets its own headers (its UI needs a far less restrictive
        # CSP than the rest of the site -- see the comment on this server's
        # own CSP below) -- a location that sets any add_header of its own
        # stops inheriting the parent's, so this isn't additive with those.
        location ^~ /grafana/ {
            set $grafana_upstream grafana;
            proxy_pass http://$grafana_upstream:3000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options "DENY" always;
        }

        # Optional: only resolves/works once analytics/docker-compose.
        # analytics.yml is deployed alongside this one (see that file) --
        # until then this location just 502s on request, same harmless
        # lazy-resolution behavior as /grafana/ above. Deliberately a
        # same-origin *subpath* (not a separate subdomain) so the tracker
        # script/data-collection calls the main site's own pages make stay
        # covered by this server's existing `connect-src 'self'`/
        # `script-src 'self'` CSP with zero loosening -- see that compose
        # file's own "WHY BUILT FROM SOURCE" comment for why that mattered
        # enough to build Umami from source instead of using its prebuilt
        # image. Own headers for the same reason as /grafana/'s (a location
        # setting any add_header stops inheriting the parent's, and Umami's
        # own dashboard UI -- reached by visiting /analytics/ directly --
        # needs more room than the rest of the site's strict CSP); access
        # control here is Umami's own login, same as Grafana's.
        #
        # No trailing slash on the pattern itself (unlike /api/ and
        # /grafana/ above) -- Next.js's own BASE_PATH handling (Umami is
        # built with BASE_PATH=/analytics) redirects "/analytics/" to
        # "/analytics" as its own canonical root; nginx's location-prefix
        # matching has the mirror-image behavior for a pattern *with* a
        # trailing slash (auto-redirecting a request that's missing it back
        # to add one) -- together those two "helpfully" opposite redirects
        # is an infinite loop, observed live the first time this deployed.
        # Dropping the slash here means both "/analytics" and
        # "/analytics/..." match this one location directly, no redirect
        # either way. The (minor, accepted) trade-off: a URI that merely
        # *starts* with the word "analytics" without a following slash --
        # e.g. a hypothetical "/analyticsfoo" -- would also match this
        # prefix instead of falling through to the front SPA; nothing else
        # on this site is named that closely, so this isn't expected to
        # ever actually collide.
        location ^~ /analytics {
            set $umami_upstream umami;
            proxy_pass http://$umami_upstream:3000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options "DENY" always;
        }

        listen [::]:443 ssl ipv6only=on;
        listen 443 ssl;
        ssl_certificate /etc/letsencrypt/live/rankme.fr/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/rankme.fr/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
        ssl_prefer_server_ciphers off;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        # front is a same-origin Vite bundle with no external scripts; MUI/emotion
        # inject <style> at runtime, hence 'unsafe-inline' for style-src; the
        # co-author avatar images are the one external resource (dblp.org).
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://dblp.org; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;

        # Two sequential ifs, evaluated in order: the acme-challenge path
        # must never hit the https redirect below (nginx runs server-level
        # ifs before location matching, so the redirect would otherwise fire
        # first on every plain-HTTP validation request from Let's Encrypt).
        if ($request_uri ~ ^/\.well-known/acme-challenge/) {
            break;
        }

        if ($http_user_agent ~* "Googlebot") {
            return 403;
        }

        if ($scheme != "https") {
            return 301 https://$host$request_uri;
        }


    }


}



