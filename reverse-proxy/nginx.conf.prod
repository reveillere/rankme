

events { worker_connections 1024; }

http {
    sendfile on;

    # Docker's embedded DNS server: resolving each upstream through a
    # variable forces nginx to re-resolve its container IP on every request
    # instead of caching whatever it was at nginx's own startup -- a static
    # `proxy_pass http://api/;` only resolves once, so recreating a
    # container without also restarting nginx silently leaves it pointing
    # at a dead/stale IP. Shared by both server blocks below.
    resolver 127.0.0.11 valid=10s;

    # Anubis (https://anubis.techaro.lol) sits between the two server
    # blocks below -- added 2026-09-15 after a distributed scrape (248k+
    # distinct IPs in 10h, ~1 req/IP, rotating a canned pool of
    # Chrome/Windows UAs) was found hammering /author/*, /dblp/* and
    # /api/dblp/author-stream/*, pushing mongo close to its memory limit.
    # Per-IP nginx rate limiting was tried first and reverted: with load
    # spread this thinly across distinct IPs, it barely dents total volume.
    # Anubis instead makes each *browser* solve a small proof-of-work
    # puzzle before it ever reaches this site's content -- trivial for a
    # real browser (sub-second, then a 7-day pass cookie), but a real cost
    # a scraper that never reuses the same IP/session has to pay on every
    # single request. See docker-compose.prod.yml's own anubis service for
    # the policy file and the RANKME_BYPASS_KEY header that lets us skip
    # the challenge for our own testing.
    #
    # No static `upstream anubis { server anubis:8923; }` block here on
    # purpose -- unlike the variable-based proxy_pass pattern this file
    # uses everywhere else (see the resolver comment above), a hostname
    # inside an upstream block is resolved once, at nginx startup. If the
    # anubis container isn't up yet at that exact moment (a real
    # possibility -- compose starts containers concurrently), nginx fails
    # to start entirely instead of just retrying on the next request.
    # Confirmed locally: `nginx -t` itself fails with "host not found in
    # upstream" when tested outside the real compose network. The location
    # below sets $anubis_upstream and proxy_passes through it instead, so
    # it re-resolves lazily per request like every other upstream here.

    # TLS-terminating front door: the only server block reachable from the
    # internet (ports 80/443 are the only ones published in
    # docker-compose.prod.yml). Everything real -- the site's own routing
    # to front/api/grafana/analytics -- lives in the second server block
    # below, listening on 8081, reachable only from other containers on
    # this compose network (anubis included) and never published to the
    # host. This split is Anubis's own documented nginx integration
    # pattern: https://anubis.techaro.lol/docs/admin/environments/nginx.
    server {
        listen 80;
        listen [::]:443 ssl ipv6only=on;
        listen 443 ssl;
        server_name localhost;

        error_log  /var/log/nginx/error.log;
        access_log /var/log/nginx/access.log;

        ssl_certificate /etc/letsencrypt/live/rankme.fr/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/rankme.fr/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
        ssl_prefer_server_ciphers off;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        # front is a same-origin Vite bundle with no external scripts; MUI/emotion
        # inject <style> at runtime, hence 'unsafe-inline' for style-src; the
        # co-author avatar images are the one external resource (dblp.org).
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://dblp.org; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;

        # Serves Let's Encrypt's HTTP-01 challenge files so certbot renew can
        # run unattended (via the existing snap.certbot.renew.timer) instead
        # of the DNS-manual flow this cert was originally issued with, which
        # silently skips on every automated renewal attempt. Must never go
        # through Anubis -- certbot's own validator doesn't solve
        # proof-of-work challenges.
        location ^~ /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        # Two sequential ifs, evaluated in order: the acme-challenge path
        # must never hit the https redirect below (nginx runs server-level
        # ifs before location matching, so the redirect would otherwise fire
        # first on every plain-HTTP validation request from Let's Encrypt).
        if ($request_uri ~ ^/\.well-known/acme-challenge/) {
            break;
        }

        if ($scheme != "https") {
            return 301 https://$host$request_uri;
        }

        # Everything else -- the actual site -- goes through Anubis first.
        # Headers per Anubis's own documented nginx recipe (X-Real-IP is
        # what Anubis uses to identify a client; X-TLS-SNI-Name/
        # X-Http-Version feed its risk signals).
        location / {
            set $anubis_upstream anubis;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Http-Version $server_protocol;
            proxy_set_header X-TLS-SNI-Name $ssl_server_name;
            # Anubis overwrites Host with its own TARGET's host:port
            # (reverseproxy:8081) when it forwards a passed request on --
            # confirmed live in testing, and undocumented as such (only
            # TARGET_HOST, for the opposite override, is mentioned). The
            # router server block below needs the real public hostname
            # (rankme.fr or www.rankme.fr) to build a correct absolute
            # redirect for /author/*, so it's preserved here under its own
            # header instead of relying on whatever Host survives the hop.
            proxy_set_header X-Forwarded-Host $host;
            proxy_pass http://$anubis_upstream:8923;
        }
    }

    # The actual site, unpublished (see the front door above): reachable
    # only from other containers on this compose network, which in
    # practice means only Anubis, once it has decided a request is worth
    # passing through.
    server {
        listen 8081;
        server_name localhost;

        # Anubis has already resolved the real client IP into X-Real-IP by
        # the time a request reaches here (see its own caveats-xff docs) --
        # $remote_addr at this hop is just the anubis container itself, so
        # every location below reads the header it forwarded instead.
        # Absolute URI in the replacement (not a bare /dblp/$1 path) so
        # nginx uses it verbatim as the Location header instead of
        # reconstructing one from $host -- which, at this hop, is
        # reverseproxy:8081 (Anubis's own TARGET authority, not the public
        # hostname the visitor actually used; see the front door's own
        # X-Forwarded-Host comment). Always https: by the time a request
        # reaches here it already passed the front door's https-only
        # redirect.
        location ^~ /author/ {
            rewrite ^/author/(.+)$ https://$http_x_forwarded_host/dblp/$1 permanent;
        }

        location / {
            set $front_upstream front;
            proxy_pass http://$front_upstream:80;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_cache_bypass $http_upgrade;
            proxy_redirect off;
            proxy_set_header X-Real-IP $http_x_real_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location ^~ /api/ {
            set $api_upstream api;
            # proxy_pass can't strip the /api/ prefix itself once the
            # upstream is a variable (a documented nginx quirk: URI
            # rewriting via the trailing "/" only applies to a literal,
            # statically-resolved proxy_pass target) -- so do it explicitly.
            rewrite ^/api/(.*)$ /$1 break;
            proxy_pass http://$api_upstream:80;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_cache_bypass $http_upgrade;
            proxy_set_header X-Real-IP $http_x_real_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_buffering off;
            proxy_read_timeout 120s;
        }

        # Optional: only resolves/works once monitoring/docker-compose.
        # monitoring.yml is deployed alongside this one (see that file) --
        # until then this location just 502s on request, which is harmless
        # (same graceful-per-request-resolution behavior as /api/ and /
        # above, not a startup failure) since nothing links to it yet.
        # Grafana gets its own headers (its UI needs a far less restrictive
        # CSP than the rest of the site -- see the front door's own CSP
        # comment) -- a location that sets any add_header of its own stops
        # inheriting the parent's, so this isn't additive with those.
        location ^~ /grafana/ {
            set $grafana_upstream grafana;
            proxy_pass http://$grafana_upstream:3000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $http_x_real_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options "DENY" always;
        }

        # Optional: only resolves/works once analytics/docker-compose.
        # analytics.yml is deployed alongside this one (see that file) --
        # until then this location just 502s on request, same harmless
        # lazy-resolution behavior as /grafana/ above. Deliberately a
        # same-origin *subpath* (not a separate subdomain) so the tracker
        # script/data-collection calls the main site's own pages make stay
        # covered by this server's existing `connect-src 'self'`/
        # `script-src 'self'` CSP with zero loosening -- see that compose
        # file's own "WHY BUILT FROM SOURCE" comment for why that mattered
        # enough to build Umami from source instead of using its prebuilt
        # image. Own headers for the same reason as /grafana/'s (a location
        # setting any add_header stops inheriting the parent's, and Umami's
        # own dashboard UI -- reached by visiting /analytics/ directly --
        # needs more room than the rest of the site's strict CSP); access
        # control here is Umami's own login, same as Grafana's.
        #
        # No trailing slash on the pattern itself (unlike /api/ and
        # /grafana/ above) -- Next.js's own BASE_PATH handling (Umami is
        # built with BASE_PATH=/analytics) redirects "/analytics/" to
        # "/analytics" as its own canonical root; nginx's location-prefix
        # matching has the mirror-image behavior for a pattern *with* a
        # trailing slash (auto-redirecting a request that's missing it back
        # to add one) -- together those two "helpfully" opposite redirects
        # is an infinite loop, observed live the first time this deployed.
        # Dropping the slash here means both "/analytics" and
        # "/analytics/..." match this one location directly, no redirect
        # either way. The (minor, accepted) trade-off: a URI that merely
        # *starts* with the word "analytics" without a following slash --
        # e.g. a hypothetical "/analyticsfoo" -- would also match this
        # prefix instead of falling through to the front SPA; nothing else
        # on this site is named that closely, so this isn't expected to
        # ever actually collide.
        location ^~ /analytics {
            set $umami_upstream umami;
            proxy_pass http://$umami_upstream:3000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $http_x_real_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options "DENY" always;
        }
    }
}
