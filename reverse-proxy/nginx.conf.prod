

events { worker_connections 1024; }

http {
    sendfile on;

    server {
        listen 80;
        server_name localhost;

        error_log  /var/log/nginx/error.log;
        access_log /var/log/nginx/access.log;

        # Docker's embedded DNS server: resolving api/front through a
        # variable (below) forces nginx to re-resolve their container IPs
        # on every request instead of caching whatever they were at nginx's
        # own startup -- a static `proxy_pass http://api/;` only resolves
        # once, so recreating the api/front containers without also
        # restarting nginx silently leaves it pointing at a dead/stale IP.
        resolver 127.0.0.11 valid=10s;

        location / {
            set $front_upstream front;
            proxy_pass http://$front_upstream:80;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_cache_bypass $http_upgrade;
            proxy_redirect off;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Serves Let's Encrypt's HTTP-01 challenge files so certbot renew can
        # run unattended (via the existing snap.certbot.renew.timer) instead
        # of the DNS-manual flow this cert was originally issued with, which
        # silently skips on every automated renewal attempt.
        location ^~ /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location ^~ /api/ {
            set $api_upstream api;
            # proxy_pass can't strip the /api/ prefix itself once the
            # upstream is a variable (a documented nginx quirk: URI
            # rewriting via the trailing "/" only applies to a literal,
            # statically-resolved proxy_pass target) -- so do it explicitly.
            rewrite ^/api/(.*)$ /$1 break;
            proxy_pass http://$api_upstream:80;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_cache_bypass $http_upgrade;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_buffering off;
            proxy_read_timeout 120s;
        }
        
        listen [::]:443 ssl ipv6only=on;
        listen 443 ssl;
        ssl_certificate /etc/letsencrypt/live/rankme.fr/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/rankme.fr/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
        ssl_prefer_server_ciphers off;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        # front is a same-origin Vite bundle with no external scripts; MUI/emotion
        # inject <style> at runtime, hence 'unsafe-inline' for style-src; the
        # co-author avatar images are the one external resource (dblp.org).
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://dblp.org; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;

        # Two sequential ifs, evaluated in order: the acme-challenge path
        # must never hit the https redirect below (nginx runs server-level
        # ifs before location matching, so the redirect would otherwise fire
        # first on every plain-HTTP validation request from Let's Encrypt).
        if ($request_uri ~ ^/\.well-known/acme-challenge/) {
            break;
        }

        if ($http_user_agent ~* "Googlebot") {
            return 403;
        }

        if ($scheme != "https") {
            return 301 https://$host$request_uri;
        }


    }


}




