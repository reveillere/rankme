{
  "title": "rankme overview",
  "uid": "rankme-overview",
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rate(rankme_requests_total[5m])", "legendFormat": "requests/s" },
        { "expr": "rate(rankme_errors_total[5m])", "legendFormat": "errors/s" }
      ]
    },
    {
      "id": 2,
      "title": "p95 latency by route (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "rankme_route_latency_ms{quantile=\"0.95\"}", "legendFormat": "{{method}} {{route}}" }
      ]
    },
    {
      "id": 3,
      "title": "Ranking queue depth",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        { "expr": "rankme_ranking_queue_depth", "legendFormat": "{{state}}" }
      ]
    },
    {
      "id": 4,
      "title": "DBLP local dump",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        { "expr": "rankme_dblp_ready", "legendFormat": "ready" },
        { "expr": "rankme_dblp_importing", "legendFormat": "importing" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "no" }, "1": { "text": "yes" } } }
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "Mongo / Redis up",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        { "expr": "rankme_mongo_up", "legendFormat": "mongo" },
        { "expr": "rankme_redis_up", "legendFormat": "redis" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "down" }, "1": { "text": "up" } } }
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "Host RAM used %",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "RAM used %"
        }
      ]
    },
    {
      "id": 7,
      "title": "Host disk used % (docker root)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "targets": [
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})",
          "legendFormat": "disk used %"
        }
      ]
    },
    {
      "id": 8,
      "title": "Host CPU load (1m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "targets": [
        { "expr": "node_load1", "legendFormat": "load1" }
      ]
    },
    {
      "id": 9,
      "title": "Container memory usage vs limit (%)",
      "type": "timeseries",
      "description": "Per-container RAM as a percentage of its own docker-compose deploy.resources.limits.memory -- what today's mongo-near-OOM incidents actually needed and node_exporter alone (host-level only) couldn't show.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 } },
      "targets": [
        { "expr": "100 * container_memory_working_set_bytes{name!=\"\"} / container_spec_memory_limit_bytes{name!=\"\"}", "legendFormat": "{{name}}" }
      ]
    },
    {
      "id": 10,
      "title": "Container memory usage (MB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "expr": "container_memory_working_set_bytes{name!=\"\"} / 1024 / 1024", "legendFormat": "{{name}}" }
      ]
    },
    {
      "id": 11,
      "title": "Container CPU usage vs limit (%)",
      "type": "timeseries",
      "description": "cpus: \"X\" in docker-compose sets a CPU quota/period whose ratio is X cores -- this divides actual usage by that same ratio, so 100% means a container is fully using its own configured CPU ceiling.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [
        { "expr": "100 * rate(container_cpu_usage_seconds_total{name!=\"\"}[1m]) / (container_spec_cpu_quota{name!=\"\"} / container_spec_cpu_period{name!=\"\"})", "legendFormat": "{{name}}" }
      ]
    },
    {
      "id": 12,
      "title": "Container CPU usage (cores)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        { "expr": "rate(container_cpu_usage_seconds_total{name!=\"\"}[1m])", "legendFormat": "{{name}}" }
      ]
    }
  ]
}
